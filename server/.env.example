# O.M.V 工作台 · 全域广播 —— 本地直跑（server/ 内 pnpm start）用
# 复制为 server/.env：cp .env.example .env
# 与 ops/.env.example 的区别：数据库/Redis/S3 均指向宿主机 localhost。

# ── API ──────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=debug
TRUST_PROXY=false
REQUEST_BODY_LIMIT_MB=80
READ_RECEIPT_WINDOW_MS=300

# ── DB ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dijiang:dijiang_dev_pw@localhost:5432/dijiang?schema=public&connection_limit=10
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://:dijiang_dev_redis@localhost:6379/0
REDIS_KEY_PREFIX=dijiang:
PRESENCE_TTL_SEC=90
TYPING_TTL_MS=3000

# ── S3 / MinIO ───────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dijiang
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SEC=900

# ── JWT ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-please-change-0001
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-01
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
JWT_ISSUER=dijiang
JWT_AUDIENCE=dijiang-web

# ── Push（未配置凭据时 push_status=skipped）──────────────────────────
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@dijiang.local
FCM_SERVER_KEY=
FCM_PROJECT_ID=
PUSH_DIGEST_WINDOW_SEC=300

# ── RTC（必须 false）─────────────────────────────────────────────────
RTC_SIGNALING_ENABLED=false
RTC_PROVIDER=none
RTC_TOKEN_TTL_SEC=600

# ── 首次引导 ─────────────────────────────────────────────────────────
OWNER_HANDLE=founder
OWNER_DISPLAY_NAME=建立者
OWNER_PASSWORD=ChangeMe#2026
SEED_PASSWORD=Dijiang#2026

# 内网穿透公网隧道域名（TCP），逗号分隔，支持 *.host.tld 子域通配
TUNNEL_ORIGINS=

# 公网 API 源（穿透/反代部署时填写；设置后文件 URL 走签名代理，不再暴露 S3）
PUBLIC_API_ORIGIN=
