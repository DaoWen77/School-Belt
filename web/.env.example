# 前端 → 后端地址（构建期注入，修改后需重新 build）
#
# 优先级（运行时）：
#   登录页保存的 localStorage（dj-server-api / dj-server-ws）
#   → 本文件的 NEXT_PUBLIC_API_BASE_URL / NEXT_PUBLIC_WS_URL
#   → 浏览器同源 window.location.origin（同源部署）
#   → SSR 无 window：env 或 http://localhost:3000
#
# 旧变量 NEXT_PUBLIC_API_BASE 仍兼容，但新部署建议用 NEXT_PUBLIC_API_BASE_URL。
# WS 可留空/注释：空=沿用 API host；API 与 WS 允许不同源。

# 本机分端口（当前 dev/start 必须有 .env.local 同样的两行，保持 3100→3000 登录）
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# 局域网示例：手机访问 http://192.168.1.9:3100 时
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.9:3000
# NEXT_PUBLIC_WS_URL=http://192.168.1.9:3000

# 同源反代示例（API/WS 与 Web 同域）：
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_WS_URL=
# 留空时 API 使用 window.location.origin；WS 沿用 API host。

# 旧变量（兼容）
# NEXT_PUBLIC_API_BASE=http://localhost:3000

# Socket.IO 传输路径（命名空间固定 /ws，不要写进这里）
NEXT_PUBLIC_WS_PATH=/socket.io
