# O.M.V 帝江号 · 全域广播 —— 环境变量清单（docker compose 用）
# 复制为 ops/.env 后按需修改：cp .env.example .env
# 分组：API / DB / Redis / S3 / JWT / Push / RTC
# 注意：本文件中的 DATABASE_URL/REDIS_URL/S3_ENDPOINT 会被 docker-compose.yml 的 api.environment 覆盖为容器内地址，
#      这里保留只是为了让单独运行（pnpm start）时也有值可读。

# ── API ──────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
TRUST_PROXY=true
REQUEST_BODY_LIMIT_MB=2
READ_RECEIPT_WINDOW_MS=300
API_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=localhost
ACME_EMAIL=ops@dijiang.local

# ── DB（PostgreSQL 16）────────────────────────────────────────────────
POSTGRES_USER=dijiang
POSTGRES_PASSWORD=dijiang_dev_pw
POSTGRES_DB=dijiang
POSTGRES_PORT=5432
DATABASE_POOL_MAX=10
DATABASE_URL=postgresql://dijiang:dijiang_dev_pw@localhost:5432/dijiang?schema=public&connection_limit=10

# ── Redis 7 ──────────────────────────────────────────────────────────
REDIS_PASSWORD=dijiang_dev_redis
REDIS_PORT=6379
REDIS_URL=redis://:dijiang_dev_redis@localhost:6379/0
REDIS_KEY_PREFIX=dijiang:
PRESENCE_TTL_SEC=90
TYPING_TTL_MS=3000

# ── S3 / MinIO ───────────────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dijiang
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SEC=900

# ── JWT（生产必须换掉！至少 32 字符随机串）───────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-please-change-0001
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-01
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
JWT_ISSUER=dijiang
JWT_AUDIENCE=dijiang-web

# ── Push（已实现适配层；未配置凭据时 push_status=skipped）────────────
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@dijiang.local
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
PUSH_DIGEST_WINDOW_SEC=300

# ── RTC（契约 §11 预留，必须为 false）────────────────────────────────
RTC_SIGNALING_ENABLED=false
RTC_PROVIDER=none
RTC_TOKEN_TTL_SEC=600
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── 首次引导（仅 init-owner / seed 脚本使用）─────────────────────────
OWNER_HANDLE=founder
OWNER_DISPLAY_NAME=建立者
OWNER_PASSWORD=ChangeMe#2026
SEED_PASSWORD=Dijiang#2026
